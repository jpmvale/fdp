{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": "..",
    "types": [
      "node"
    ],
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts"
  ],
  "references": [
    {
      "path": "../packages/protocol"
    },
    {
      "path": "../packages/rules"
    },
    {
      "path": "../packages/room"
    }
  ]
}
